						"folderPath": "datos_csv",
						"fileSystem": "raw"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "nro_parada",
						"type": "String"
					},
					{
						"name": "nombre_parada",
