					"scriptLines": [
						"source(output(",
						"          AnioFuente as string,",
						"          VehiculoId as string,",
						"          Placa as string,",
						"          TipoVehiculo as string,",
						"          CapacidadEfectiva as string,",
						"          VigenciaDesde as string,",
						"          VigenciaHasta as string,",
						"          Estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> bronze",
						"bronze derive(VehiculoId = trim(VehiculoId),",
						"          Placa = upper(trim(Placa)),",
						"          TipoVehiculo = upper(trim(TipoVehiculo)),",
						"          CapacidadEfectiva = toInteger(trim(CapacidadEfectiva)),",
						"          VigenciaDesde = coalesce(toDate(left(trim(VigenciaDesde),10),'yyyy-MM-dd'), toDate(trim(VigenciaDesde),'dd/MM/yyyy')),",
						"          VigenciaHasta = coalesce(toDate(left(trim(VigenciaHasta),10),'yyyy-MM-dd'), toDate(trim(VigenciaHasta),'dd/MM/yyyy')),",
						"          AnioFuente = coalesce(toShort(trim(AnioFuente)), toShort(year(toDate(left(trim(VigenciaDesde),10),'yyyy-MM-dd'))))) ~> limpieza",
						"limpieza sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          AnioFuente as integer,",
						"          VehiculoId as string,",
						"          Placa as string,",
						"          TipoVehiculo as string,",
						"          CapacidadEfectiva as integer,",
						"          VigenciaDesde as date,",
						"          VigenciaHasta as date,",
						"          Estado as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'allErrors',",
						"     transactionCommit: 'single',",
						"     reportSuccessOnError: true) ~> sinkSilverParadas"
					]
				}
			},
			"dependsOn": []
		},
