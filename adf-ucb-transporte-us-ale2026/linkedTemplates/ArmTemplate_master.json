{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ucb-transporte-us-ale2026"
		},
		"ls_datalake_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"ls_datalake\""
		},
		"ls_sql_dw_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"ls_sql_dw\""
		},
		"ls_sql_erp_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"ls_sql_erp\""
		},
		"ls_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saucbtransporteale2026.dfs.core.windows.net/"
		},
		"ls_sql_dw_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporte-ale2026.database.windows.net"
		},
		"ls_sql_dw_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_transporte"
		},
		"ls_sql_dw_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "alejandro"
		},
		"ls_sql_erp_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-transporte-ale2026.database.windows.net"
		},
		"ls_sql_erp_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp_transporte_db"
		},
		"ls_sql_erp_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "alejandro"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI de la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas."
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Token de SAS para la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-ucb-transporte-us-ale2026_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_datalake_accountKey": {
						"value": "[parameters('ls_datalake_accountKey')]"
					},
					"ls_sql_dw_password": {
						"value": "[parameters('ls_sql_dw_password')]"
					},
					"ls_sql_erp_password": {
						"value": "[parameters('ls_sql_erp_password')]"
					},
					"ls_datalake_properties_typeProperties_url": {
						"value": "[parameters('ls_datalake_properties_typeProperties_url')]"
					},
					"ls_sql_dw_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_dw_properties_typeProperties_server')]"
					},
					"ls_sql_dw_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_dw_properties_typeProperties_database')]"
					},
					"ls_sql_dw_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_dw_properties_typeProperties_userName')]"
					},
					"ls_sql_erp_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_erp_properties_typeProperties_server')]"
					},
					"ls_sql_erp_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_erp_properties_typeProperties_database')]"
					},
					"ls_sql_erp_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_erp_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-ucb-transporte-us-ale2026_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-ucb-transporte-us-ale2026_ArmTemplate_0')]"
			]
		}
	]
}